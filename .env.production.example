DOMAIN=pts.example.com
API_BASE_URL=https://pts.example.com/api

POSTGRES_USER=pts
POSTGRES_PASSWORD=replace-with-long-random-db-password
POSTGRES_DB=pts_express
DATABASE_URL=postgresql://pts:replace-with-long-random-db-password@postgres:5432/pts_express?schema=public

JWT_SECRET=replace-with-at-least-64-random-characters
PORT=3000
NODE_ENV=production

SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=replace-with-long-random-owner-password

REQUIRE_R2=true
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET=pts-express
R2_PUBLIC_BASE_URL=https://cdn.example.com

BACKUP_RETENTION_DAYS=14
BACKUP_HEALTHCHECK_URL=
