generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum WarehouseCode {
  TH
  LA
}

enum ParcelStatus {
  RECEIVED_IN_THAILAND
  ARRIVED_IN_LAOS
  PICKED_UP
}

enum ParcelCodeKind {
  BARCODE
  QR
  MANUAL
  GENERATED
}

enum ParcelEventType {
  RECEIVED_IN_THAILAND
  ARRIVED_IN_LAOS
  PICKED_UP
  ADMIN_OVERRIDE
  PHOTO_ADDED
  NOTE_ADDED
}

enum ParcelPhotoType {
  PHOTO
  SIGNATURE
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  displayName  String
  role         UserRole      @default(STAFF)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdParcels Parcel[]    @relation("ParcelCreatedBy")
  events       ParcelEvent[]
  auditLogs    AuditLog[]
}

model Warehouse {
  id        String        @id @default(cuid())
  code      WarehouseCode @unique
  name      String
  country   String
  createdAt DateTime      @default(now())
  parcels   Parcel[]
  events    ParcelEvent[]
}

model Parcel {
  id                 String       @id @default(cuid())
  trackingCode       String       @unique
  status             ParcelStatus @default(RECEIVED_IN_THAILAND)
  customerName       String
  customerPhone      String?
  labelName          String?
  note               String?
  currentWarehouseId String?
  currentWarehouse   Warehouse?   @relation(fields: [currentWarehouseId], references: [id])
  createdById        String?
  createdBy          User?        @relation("ParcelCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  codes              ParcelCode[]
  events             ParcelEvent[]
  photos             ParcelPhoto[]

  @@index([status])
  @@index([customerName])
  @@index([customerPhone])
}

model ParcelCode {
  id             String         @id @default(cuid())
  parcelId       String
  parcel         Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  rawCode        String
  normalizedCode String         @unique
  kind           ParcelCodeKind @default(MANUAL)
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([parcelId])
}

model ParcelEvent {
  id               String           @id @default(cuid())
  parcelId         String
  parcel           Parcel           @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  eventType        ParcelEventType
  fromStatus       ParcelStatus?
  toStatus         ParcelStatus?
  note             String?
  happenedAt       DateTime
  createdAt        DateTime         @default(now())
  actorId          String?
  actor            User?            @relation(fields: [actorId], references: [id])
  warehouseId      String?
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id])
  clientMutationId String?           @unique
  deviceId         String?
  photos           ParcelPhoto[]

  @@index([parcelId, happenedAt])
  @@index([eventType])
}

model ParcelPhoto {
  id             String          @id @default(cuid())
  parcelId       String
  parcel         Parcel          @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  eventId        String?
  event          ParcelEvent?    @relation(fields: [eventId], references: [id])
  type           ParcelPhotoType @default(PHOTO)
  url            String
  key            String?
  note           String?
  capturedAt     DateTime?
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  addressText    String?
  createdAt      DateTime        @default(now())
  uploadedBy     String?

  @@index([parcelId, createdAt])
  @@index([eventId])
}

model BarcodeSequence {
  id        String   @id @default(cuid())
  prefix    String
  date      String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, date])
}

model AuditLog {
  id               String   @id @default(cuid())
  action           String
  entityType       String
  entityId         String?
  actorId          String?
  actor            User?    @relation(fields: [actorId], references: [id])
  metadata         Json?
  clientMutationId String?
  createdAt        DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
}
