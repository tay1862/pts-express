FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
ARG API_BASE_URL
ARG APP_BUILD_ID=dev
ARG APP_BUILD_TIME=unknown
ARG APP_VERSION=1.0.0+1
RUN flutter build web --release --dart-define=API_BASE_URL=${API_BASE_URL} --dart-define=APP_BUILD_ID=${APP_BUILD_ID} --dart-define=APP_BUILD_TIME=${APP_BUILD_TIME} --dart-define=APP_VERSION=${APP_VERSION}

FROM nginx:1.27-alpine
ARG APP_BUILD_ID=dev
ARG APP_BUILD_TIME=unknown
ARG APP_VERSION=1.0.0+1
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
RUN printf '{"appVersion":"%s","buildId":"%s","buildTime":"%s"}\n' "$APP_VERSION" "$APP_BUILD_ID" "$APP_BUILD_TIME" > /usr/share/nginx/html/release.json
EXPOSE 80
